# No Spotify, Home Assistant or Music Assistant credentials needed in mock mode.
MUSIC_BACKEND=mock
HUB_PORT=3210
# Loopback by default. Set to your Docker host LAN address for household access.
BIND_ADDRESS=127.0.0.1
# Optional: one-time setup code. If blank, a random code is printed on first run.
PARENT_SETUP_CODE=
# Optional: bootstrap a password (at least 12 characters) instead of web setup.
# Only applied when the database does not yet have a parent password.
PARENT_PASSWORD=
# Set the exact browser origin if using a reverse proxy, e.g. https://music.example.net
PUBLIC_ORIGIN=
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
# Optional dedicated bearer token for /api/automation/screen. Use at least 32 random characters.
AUTOMATION_TOKEN=
# Switch MUSIC_BACKEND to music-assistant when you have installed it separately.
MA_URL=
MA_BROWSER_PLAYER_ID=
HUB_MPD_BIND_ADDRESS=127.0.0.1
BROWSER_MPD_PORT=6600
BROWSER_MPD_SECOND_PORT=6601
MA_TOKEN=
# Optional exact schema pin. See docs/music-assistant.md.
MA_EXPECTED_SCHEMA=
# Only used to initialise an empty real-mode database. Select target in Parent settings later.
MA_PLAYER_ID=
# Playback command acknowledgement timeout (1000–35000 ms); metadata reads stay short.
MA_COMMAND_TIMEOUT_MS=30000
# Local npm development defaults:
PORT=3000
DATABASE_PATH=data/hub.sqlite

# Optional voice service: use compose.voice.yaml; keep credentials outside this repo.
VOICE_ENABLED=false
VOICE_STT_URL=https://speech.example.net:8443
VOICE_STT_API_KEY_FILE=
VOICE_STT_CA_FILE=
VOICE_STT_TIMEOUT_MS=35000
VOICE_MAX_RECORDING_SECONDS=10

# Opt-in two-device trial. Requires two distinct MA MPD players on consecutive
# ports starting at BROWSER_MPD_PORT. Default false preserves one-player mode.
INDEPENDENT_PLAYBACK=false
MA_DEVICE_PLAYER_IDS=
