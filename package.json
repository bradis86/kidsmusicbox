{
  "name": "kids-music-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --experimental-sqlite dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:independent": "E2E_INDEPENDENT_PLAYBACK=true playwright test --grep 'independent devices'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "ws": "8.22.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
